# Port the API (and, in production, the built frontend) is served on.
PORT=3001
# SQLite database file. Use ":memory:" for a throwaway database.
DATABASE_PATH=./data/recall.db
# "production" enables Secure cookies (requires HTTPS) and serves dist/client.
NODE_ENV=development
# Question generation with Claude (server-side only — never exposed to the browser).
# Leave unset to turn the feature off; the UI then hides it.
# ANTHROPIC_API_KEY=
# QUESTION_GENERATION=on   # use credentials from an `ant auth login` profile instead of a key
# QUESTION_GENERATION=off  # force the feature off even when a key is present
# QUESTION_MODEL=claude-opus-5-5
